{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "@upstash/context7-mcp"
        ]
      },
      "jina": {
        "type": "remote",
        "url": "https://mcp.jina.ai/v1",
        "headers": {
          "Authorization": "Bearer ${JINA_API_KEY}"
        }
      }
    }
  }
}
